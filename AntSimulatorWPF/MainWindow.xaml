<Window x:Class="AntSimulatorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Симулятор Муравья" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="15">
                <TextBlock Text="Размер поля:" FontWeight="Bold" Margin="0,10,0,5"/>
                <ComboBox x:Name="cbSize" SelectedIndex="0" Margin="0,0,0,15">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="30"/>
                </ComboBox>

                <Button Content="Сгенерировать поле" Click="BtnGenerate_Click" Margin="0,0,0,20" Padding="5"/>

                <TextBlock x:Name="txtStatus" Text="Перетащите действие на поле" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="10" Background="White">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="GameCanvas" Width="600" Height="600" 
                            AllowDrop="True" 
                            Drop="GameCanvas_Drop"
                            DragOver="GameCanvas_DragOver">
                    </Canvas>
                </Viewbox>
            </Border>
        </Grid>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="0,1,0,0" Background="#F0F0F0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Действия (перетащите на поле):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,20,0"/>

                <Button Content="Идти" Tag="Go" PreviewMouseLeftButtonDown="Action_PreviewMouseLeftButtonDown" Width="100" Height="40" Margin="10"/>
                <Button Content="Поворот 90°" Tag="Turn" PreviewMouseLeftButtonDown="Action_PreviewMouseLeftButtonDown" Width="100" Height="40" Margin="10"/>
                <Button Content="Закрасить" Tag="Paint" PreviewMouseLeftButtonDown="Action_PreviewMouseLeftButtonDown" Width="100" Height="40" Margin="10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>